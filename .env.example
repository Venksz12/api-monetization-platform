APP_ENV=development
GATEWAY_HTTP_ADDR=:8080
WALLET_GRPC_ADDR=:9090
METERING_METRICS_ADDR=:9101
BILLING_METRICS_ADDR=:9102

UPSTREAM_URL=http://host.docker.internal:9000

NATS_URL=nats://localhost:4222
NATS_STREAM=API_PLATFORM
NATS_MAX_DELIVER=5

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=100

COUCHBASE_CONNSTR=couchbase://localhost
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=password
COUCHBASE_BUCKET=api_monetization
COUCHBASE_SCOPE=app

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME_PREFIX=api-monetization
